# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — nothing here is ever shared automatically. The real deployed
# site doesn't use this file at all; it gets its values from Amplify
# Hosting's own Console-configured environment variables instead. This file
# only matters for local dev (npm run dev) and building the frontend
# Docker image on your own machine.

# From AWS Console -> Cognito -> User pools -> your pool -> App integration
# -> Domain.
VITE_COGNITO_DOMAIN=

# From AWS Console -> Cognito -> User pools -> your pool -> App integration
# -> your app client.
VITE_COGNITO_CLIENT_ID=

VITE_COGNITO_SCOPE=openid email profile

# Optional: override redirect URI if needed
# VITE_REDIRECT_URI=http://localhost:5173/callback

# Backend API base URL (bare dev and Docker Compose both expose it on 3000)
VITE_API_URL=http://localhost:3000
