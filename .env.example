# Copy this file to .env and fill in real values. .env is gitignored —
# nothing here is ever shared automatically. docker compose up will refuse
# to start until all of these are set.

# Any values you want for the local Postgres container.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# From AWS Console -> Cognito -> User pools -> your pool -> "User pool ID".
COGNITO_USER_POOL_ID=

# From AWS Console -> Cognito -> User pools -> your pool -> App integration
# -> your app client.
COGNITO_CLIENT_ID=
