generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Based on the drawSQL diagram (2026-09-28). DB columns are snake_case via
// @map so raw SQL never needs quoted identifiers; Prisma fields are camelCase.

// Role inside one building. Global super-users are users.is_admin instead.
enum UserRole {
  committee_head
  committee_member
  manager
  resident

  @@map("user_role")
}

enum RelationType {
  owner
  tenant

  @@map("relation_type")
}

enum PaymentMethod {
  cash
  transfer
  bit
  paybox

  @@map("payment_method")
}

enum ContactType {
  email
  whatsapp
  phone

  @@map("contact_type")
}

enum MessageType {
  general
  urgent
  maintenance

  @@map("message_type")
}

// id = official CBS (הלמ"ס) "סמל יישוב" settlement code — never generated.
// Seeded from prisma/data/cities.json by prisma/seed.ts.
model City {
  id        Int        @id
  name      String
  buildings Building[]

  @@map("cities")
}

model Building {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId       Int                  @map("city_id")
  city         City                 @relation(fields: [cityId], references: [id])
  address      String
  // text, not a number: door codes can have leading zeros ("0123").
  entryCode    String?              @map("entry_code")
  name         String               @map("building_name")
  description  String?
  // Shared join password (hashed). Not in the diagram, but joining needs it.
  passwordHash String               @map("password_hash")
  createdAt    DateTime             @default(now()) @map("created_at")
  members      BuildingUser[]
  roles        UserRoleAssignment[]
  contactLinks ContactLink[]
  docs         Doc[]
  messages     Message[]

  @@unique([cityId, address])
  @@map("buildings")
}

model User {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Cognito identity — not in the diagram, but every request is resolved by it.
  cognitoSub  String               @unique @map("cognito_sub")
  name        String?
  phoneNum    String?              @map("phone_num")
  // Nullable: Cognito tokens don't guarantee an email claim.
  email       String?              @unique
  isAdmin     Boolean              @default(false) @map("is_admin")
  // Onboarding profile (not in the diagram, used by the onboarding flow).
  language    String?
  userType    String?              @map("user_type")
  onboardedAt DateTime?            @map("onboarded_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  memberships BuildingUser[]
  roles       UserRoleAssignment[]
  docs        Doc[]
  messages    Message[]

  @@map("users")
}

model UserRoleAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildingId String   @map("building_id") @db.Uuid
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  role       UserRole

  @@unique([userId, buildingId, role])
  @@map("users_roles")
}

model BuildingUser {
  id             Int            @id @default(autoincrement())
  buildingId     String         @map("building_id") @db.Uuid
  building       Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  userId         String         @map("user_id") @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment      Int?           @db.SmallInt
  floor          Int?
  relationType   RelationType?  @map("relation_type")
  sqrm           Int?
  monthlyPayment Int?           @map("monthly_payment")
  paymentMethod  PaymentMethod? @map("payment_method")
  joinedAt       DateTime       @default(now()) @map("joined_at")

  @@unique([buildingId, userId])
  @@map("building_users")
}

model ContactLink {
  id         Int         @id @default(autoincrement())
  buildingId String      @map("building_id") @db.Uuid
  building   Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  type       ContactType
  link       String

  @@map("contact_links")
}

model Doc {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  uploaderId String   @map("uploader") @db.Uuid
  uploader   User     @relation(fields: [uploaderId], references: [id])
  title      String
  uploadDate DateTime @default(now()) @map("upload_date")
  // Storage key of the file, relative to UPLOADS_DIR (never a user-supplied path).
  src        String
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")

  @@index([buildingId, uploadDate])
  @@map("docs")
}

model Message {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buildingId  String      @map("building_id") @db.Uuid
  building    Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  authorId    String      @map("author") @db.Uuid
  author      User        @relation(fields: [authorId], references: [id])
  type        MessageType @default(general)
  title       String
  description String?
  uploadDate  DateTime    @default(now()) @map("upload_date")

  @@index([buildingId, uploadDate])
  @@map("messages")
}
