# Copy this file to .env and fill in real values. .env is gitignored —
# nothing here is ever shared automatically.

# Match whatever you put in the root .env for local Docker Postgres, or
# point at any Postgres instance you like.
DATABASE_URL="postgresql://buildy:buildy@localhost:5433/buildy?schema=public"

# From AWS Console -> Cognito -> User pools -> your pool -> "User pool ID".
COGNITO_USER_POOL_ID=

# From AWS Console -> Cognito -> User pools -> your pool -> App integration
# -> your app client.
COGNITO_CLIENT_ID=
